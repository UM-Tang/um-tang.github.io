---
import { Image } from "astro:assets";

// Shared by Education, Research Experience, Projects, Awards and Teaching:
// optional logo on the left, name and role in the middle, dates aligned in a
// column on the right. One component for all of them keeps the rhythm of the
// page identical from section to section.
//
// Every field except `org` is optional:
//   org    institution, project or course name (bold)
//   desc   one or two sentences on what it is
//   role   your role, advisor, or anything secondary
//   date   right-hand column; keep the format consistent across sections
//   logo   imported institutional image
//   figure imported project illustration, linked through figureHref
//   url    makes `org` a link
//   links  a row of outlined buttons — Code, Website, Docs, Slides, whatever
//          the entry has — in the same style the publication list uses
const { items } = Astro.props;
const withLogo = items.some((e) => e.logo);
---

<div class:list={["entries", withLogo && "has-logo"]}>
  {
    items.map((e) => (
      <article class="entry">
        {withLogo && (
          <span class="entry-logo">
            {e.logo && (
              <Image
                src={e.logo}
                alt=""
                widths={[120, 240]}
                sizes="120px"
                loading="lazy"
              />
            )}
          </span>
        )}
        <div>
          <p class="entry-org">
            <strong>
              {e.url ? (
                <a href={e.url} target="_blank" rel="noopener noreferrer">
                  {e.org}
                </a>
              ) : (
                e.org
              )}
            </strong>
          </p>
          {/* Description first, advisor second: say what the thing is before
              saying who supervised it. */}
          {e.desc && <p class="entry-desc">{e.desc}</p>}
          {e.role && <p class="entry-role muted">{e.role}</p>}
          {e.advisor && <p class="entry-role muted">{e.advisor}</p>}
          {e.status && <p class="entry-status">{e.status}</p>}
          {e.figure && (
            <figure class="entry-figure">
              <a href={e.figureHref} target="_blank" rel="noopener noreferrer" aria-label={`View ${e.org} paper`}>
                <Image src={e.figure} alt={e.figureAlt} loading="lazy" />
              </a>
              <figcaption>{e.figureCaption}</figcaption>
            </figure>
          )}
          {e.highlights?.length > 0 && (
            <ul class="entry-highlights">
              {e.highlights.map((point) => <li>{point}</li>)}
            </ul>
          )}
          {/* The same outlined buttons the publication list uses, so a project
              with code and docs reads like a paper with a PDF and a repo. */}
          {e.links?.length > 0 && (
            <div class="entry-actions">
              {e.links.map((l) => (
                <a
                  class="pill"
                  href={l.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {l.label}
                </a>
              ))}
            </div>
          )}
        </div>
        <span class="entry-date muted-2">{e.date}</span>
      </article>
    ))
  }
</div>
